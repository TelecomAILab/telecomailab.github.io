---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ResourceIcon from "./ResourceIcon.astro";
import type { Hardware } from "../lib/lab-schemas";
interface Props { equipment: Hardware; projects?: ReadonlyMap<string, { title: string }> }
const { equipment, projects = new Map() } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/hardware/*.{jpg,jpeg,png,webp,svg}", { eager: true });
const image = equipment.image ? images[equipment.image]?.default : undefined;
const longDescription = (equipment.description?.length ?? 0) > 220;
const longSpecifications = (equipment.specifications?.length ?? 0) > 120;
const extraDetails = longDescription || longSpecifications || equipment.purchaseDate || equipment.manufacturer || equipment.model || equipment.location;
const search = [equipment.title, equipment.hardwareCategory, equipment.description, equipment.specifications, equipment.manufacturer, equipment.model, equipment.location, equipment.availability, ...equipment.researchApplications, ...equipment.relatedProjectIds.map((id) => projects.get(id)?.title)].filter(Boolean).join(" ").toLowerCase();
---
<article id={`resource-${equipment.id}`} data-resource data-hardware data-search-entry data-search-title={equipment.title} data-search-category="Resources" data-category="Hardware" data-search={search} class="hardware-card flex min-w-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex aspect-[16/9] items-center justify-center border-b border-slate-100 bg-slate-50 text-primary-700">
    {image ? <Image src={image} alt={equipment.imageAlt!} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="h-full w-full object-contain" loading="lazy" /> : <div class="flex flex-col items-center gap-3 py-6"><ResourceIcon category="Hardware" class="h-14 w-14" /><span class="text-xs text-slate-500">Equipment image pending</span></div>}
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs"><span class="rounded-full bg-primary-50 px-2.5 py-1 font-medium text-primary-700">Hardware</span>{equipment.purchaseYear && <span class="text-slate-500">Purchased {equipment.purchaseYear}</span>}</div>
    <h3 class="font-serif text-xl leading-snug [overflow-wrap:anywhere]">{equipment.title}</h3>
    {equipment.hardwareCategory && <p class="mt-2 text-sm font-medium text-primary-700">{equipment.hardwareCategory}</p>}
    {equipment.description && !longDescription && <p class="mt-3 text-sm leading-relaxed text-slate-600">{equipment.description}</p>}
    {equipment.specifications && !longSpecifications && <div class="mt-4 border-t border-slate-100 pt-4 text-sm"><p class="text-xs font-medium text-slate-500">Reported specifications</p><p class="mt-1 whitespace-pre-line text-slate-700">{equipment.specifications}</p><p class="mt-1 text-xs text-slate-500">Source values · unverified</p></div>}
    {(equipment.quantity !== undefined || equipment.availability) && <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">{equipment.quantity !== undefined && <div><dt class="text-xs text-slate-500">Quantity</dt><dd class="mt-1 text-slate-700">{equipment.quantity}</dd></div>}{equipment.availability && <div><dt class="text-xs text-slate-500">Availability</dt><dd class="mt-1 text-slate-700">{equipment.availability}</dd></div>}</dl>}
    {equipment.researchApplications.length > 0 && <div class="mt-4 text-sm"><p class="text-xs font-medium text-slate-500">Research applications</p><p class="mt-1 text-slate-600">{equipment.researchApplications.join(" · ")}</p></div>}
    {equipment.relatedProjectIds.length > 0 && <div class="mt-4 text-sm"><p class="mb-1 text-xs font-medium text-slate-500">Related projects</p>{equipment.relatedProjectIds.map((id) => <a href={`/funding#project-${id}`} class="block text-primary-700 hover:underline">{projects.get(id)?.title}</a>)}</div>}
    {extraDetails && <details class="mt-4 border-t border-slate-100 pt-4 text-sm"><summary class="w-fit cursor-pointer font-medium text-primary-700">Details<span class="sr-only"> for {equipment.title}</span></summary><div class="mt-3 space-y-3 leading-relaxed text-slate-600">{longDescription && <p class="whitespace-pre-line">{equipment.description}</p>}{longSpecifications && <div><p class="font-medium">Reported specifications · unverified</p><p class="mt-1 whitespace-pre-line">{equipment.specifications}</p></div>}{equipment.manufacturer && <p>Manufacturer: {equipment.manufacturer}</p>}{equipment.model && <p>Model: {equipment.model}</p>}{equipment.purchaseDate && <p>Purchase date: <time datetime={equipment.purchaseDate}>{equipment.purchaseDate}</time></p>}{equipment.location && <p>Location: {equipment.location}</p>}</div></details>}
    {equipment.sourceUrl && <div class="mt-auto pt-5"><a href={equipment.sourceUrl} class="text-sm font-medium text-primary-700 hover:underline">Equipment source <span class="sr-only">for {equipment.title}</span><span aria-hidden="true"> &rarr;</span></a></div>}
  </div>
</article>
<style>
  .hardware-card[hidden] { display: none; }
</style>
