---
import { calendarEvent, type ScheduledTalk } from "../lib/calendar";
interface Props { talk: ScheduledTalk; speaker: string }
const { talk, speaker } = Astro.props;
const event = calendarEvent(talk, speaker);
---
{event && <details class="relative mt-4 w-fit text-xs" data-calendar-actions data-calendar-start={event.date} hidden>
  <summary class="flex min-h-10 cursor-pointer list-none items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 font-medium text-primary-700 hover:border-primary-300 hover:bg-primary-50"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6m10-6v6M3 11h18m-6 4v4m-2-2h4"/></svg>Add to calendar <span aria-hidden="true">⌄</span></summary>
  <ul class="absolute left-0 top-full z-10 mt-1 w-56 rounded-lg border border-slate-200 bg-white p-1 shadow-lg">
    <li><a href={event.google} target="_blank" rel="noopener noreferrer" class="block rounded px-3 py-2.5 text-slate-700 hover:bg-primary-50">Add to Google Calendar ↗</a></li>
    <li><a href={event.outlook} target="_blank" rel="noopener noreferrer" class="block rounded px-3 py-2.5 text-slate-700 hover:bg-primary-50">Add to Outlook Calendar ↗</a></li>
    <li><a href={`/talks/${talk.id}.ics`} download class="block rounded px-3 py-2.5 text-slate-700 hover:bg-primary-50">Download Calendar (.ics)</a></li>
  </ul>
</details>}
<script>
  import "../scripts/calendar-actions";
</script>
