---
import { site } from "../data/site";
import SocialIcon from "./SocialIcon.astro";
const year = new Date().getFullYear();
const isPlaceholder = (href: string) => new URL(href, site.url).hostname.endsWith(".invalid");
const socialLinks = [
  { name: "scholar", label: "Google Scholar", href: site.social.scholar },
  { name: "github", label: "GitHub", href: site.social.github },
  { name: "facebook", label: "Facebook", href: site.social.facebook },
  { name: "twitter", label: "Twitter / X", href: site.social.twitter },
  { name: "linkedin", label: "LinkedIn", href: site.social.linkedin },
  { name: "slack", label: "Slack", href: site.social.slack },
  { name: "youtube", label: "YouTube", href: site.social.youtube },
  { name: "telegram", label: "Telegram", href: site.social.telegram },
  { name: "rss", label: "RSS", href: site.social.rss },
] as const;
---
<footer class="mt-20 border-t border-slate-200 bg-slate-50" data-site-footer>
  <div class="container-page flex flex-col items-center gap-4 py-11 text-center">
    <p class="font-serif text-2xl font-semibold text-slate-900">{site.name}</p>
    <p class="max-w-3xl text-sm leading-relaxed text-slate-500">{site.researchGroup}, {site.institution} · {site.university}</p>
    <ul class="flex flex-wrap items-center justify-center gap-1" aria-label="Social networks">
      {socialLinks.filter((link) => link.href).map((link) => {
        const placeholder = isPlaceholder(link.href!);
        const label = placeholder ? `${link.label} (placeholder URL)` : link.label;
        return <li><a href={link.href} aria-label={label} title={label} data-placeholder={placeholder || undefined} target={link.href?.startsWith("http") ? "_blank" : undefined} rel={link.href?.startsWith("http") ? "noopener noreferrer" : undefined} class="flex h-11 w-11 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-primary-100 hover:text-primary-700"><SocialIcon name={link.name} /></a></li>;
      })}
    </ul>
  </div>
  <div class="border-t border-slate-200">
    <div
      class="container-page flex flex-col gap-1 py-4 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}.</p>
      <p>Built with Astro &amp; Tailwind CSS.</p>
    </div>
  </div>
</footer>
