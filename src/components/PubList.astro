---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { Publication } from "../lib/content";
import { personForAuthor, publicationRoles } from "../lib/publication-authors";
import type { PublicationAuthor } from "../lib/publication-schema";
import { personDisplayName } from "../lib/people-schema";
import { PUBLICATION_TYPE_LABELS } from "../lib/publication-schema";
import { publicationSearchText, publicationType, toBibtex, venueCitation } from "../lib/publication-format";

interface Props {
  pubs: Publication[];
  anchorIds?: boolean;
}
const { pubs, anchorIds = false } = Astro.props;

const people = await getCollection("people");
const directory = new Map(people.map((person) => [person.id, person]));
const findPerson = (author: PublicationAuthor) => personForAuthor(author, directory);

// Unique linked members with headshots, in publication author order.
const labPeopleFor = (p: Publication) => {
  const seen = new Set<string>();
  const out: typeof people = [];
  for (const a of p.data.authors) {
    const d = findPerson(a);
    if (!d || !d.data.headshot || seen.has(d.id)) continue;
    seen.add(d.id);
    out.push(d);
  }
  return out;
};

const shortName = (name: string) => name.split(",")[0].trim();
const anyMarks = pubs.some((p) => p.data.authors.some((author) => author.coFirst || author.coSenior));
const anyCorresponding = pubs.some((p) => p.data.authors.some((author) => author.corresponding));
---

<ol class="space-y-4" data-pub-list data-search-ignore={!anchorIds || undefined}>
  {
    pubs.map((p) => {
      const d = p.data;
      const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
      const search = [publicationSearchText(d), ...d.authors.flatMap((author) => {
        const member = findPerson(author);
        return member ? [member.data.name, personDisplayName(member.data)] : [];
      })].join(" ").toLowerCase();
      const { menteeLed, piFirstOrSenior, collaboration, featured } = publicationRoles(d, directory);
      const labPeople = labPeopleFor(p);
      const type = publicationType(d);
      const bibtex = toBibtex(d);
      const links = [
        { label: "PDF", href: d.pdfUrl }, { label: "Code", href: d.codeUrl },
        { label: "DOI", href: d.doi ? `https://doi.org/${encodeURIComponent(d.doi).replace(/%2F/gi, "/")}` : undefined },
        { label: "arXiv", href: d.arxivId ? `https://arxiv.org/abs/${d.arxivId}` : undefined },
        { label: "Slides", href: d.slidesUrl }, { label: "Project", href: d.projectUrl },
        { label: "Scholar", href: d.scholarUrl }, ...(d.presentationMaterials ?? []).map((material) => ({ label: material.label, href: material.url })),
      ].filter((resource): resource is { label: string; href: string } => Boolean(resource.href));
      return (
        <li
          class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"
          data-pub
          data-pub-id={p.id}
          data-search-entry={anchorIds || undefined}
          data-search-category={anchorIds ? "Publications" : undefined}
          data-search-title={anchorIds ? d.title : undefined}
          data-search-extra={anchorIds ? search : undefined}
          id={anchorIds ? `publication-${p.id}` : undefined}
          data-title={d.title}
          data-type={type}
          data-year={d.year}
          data-citations={typeof d.citations === "number" ? d.citations : -1}
          data-featured={featured}
          data-mentee={menteeLed}
          data-pi-senior={piFirstOrSenior}
          data-collaboration={collaboration}
          data-openaccess={d.openAccess}
          data-areas={d.areas.join(" ")}
          data-search={search}
        >
          <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-full bg-primary-50 px-2 py-0.5 font-medium text-primary-800">{PUBLICATION_TYPE_LABELS[type]}</span>
            {featured && <span class="font-medium text-accent-700">Featured</span>}
          </div>
          <p class="break-words font-medium text-slate-900">
            {link ? (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary-700 hover:underline"
              >
                {d.title}
              </a>
            ) : (
              d.title
            )}
          </p>

          <p class="mt-1 text-sm text-slate-600">
            <span class:list={["authors", d.authors.length > 14 && "clamped"]}>
              {d.authors.map((a, i) => {
                const person = findPerson(a);
                // Only a co-first/-senior (*) marker. Mentees are conveyed by
                // bolded name links + headshots, so they get no marker.
                const mark = a.coFirst || a.coSenior ? "*" : "";
                return (
                  <span class="au">
                    {i > 0 && ", "}
                    {person ? (
                      <a
                        href={`/people/${person.id}`}
                        class="font-medium text-slate-900 hover:text-primary-700 hover:underline"
                      >
                        {a.name}
                      </a>
                    ) : (
                      a.name
                    )}
                    {mark && <sup class="font-semibold text-slate-600" title={[a.coFirst && "Co-first author", a.coSenior && "Co-senior author"].filter(Boolean).join("; ")}>{mark}</sup>}
                    {a.corresponding && <sup class="ml-0.5 text-primary-700" title="Corresponding author" aria-label="Corresponding author">†</sup>}
                  </span>
                );
              })}
            </span>
            {d.authors.length > 14 && (
              <button
                type="button"
                data-authors-toggle
                data-more={`… +${d.authors.length - 12} more`}
                class="ml-1 whitespace-nowrap text-primary-700 hover:underline"
              >
                … +{d.authors.length - 12} more
              </button>
            )}
          </p>

          <p class="mt-0.5 text-sm text-slate-600">
            {venueCitation(d)}
          </p>

          {labPeople.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {labPeople.map((m) => (
                <a
                  href={`/people/${m.id}`}
                  class="group flex items-center gap-2"
                  title={personDisplayName(m.data)}
                >
                  {m.data.headshot && (
                    <Image
                      src={m.data.headshot}
                      alt={personDisplayName(m.data)}
                      width={64}
                      height={64}
                      class="h-8 w-8 rounded-full object-cover ring-1 ring-slate-200 group-hover:ring-primary-300"
                    />
                  )}
                  <span class="text-xs text-slate-600 group-hover:text-primary-700">
                    {shortName(personDisplayName(m.data))}
                  </span>
                </a>
              ))}
            </div>
          )}

          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            {typeof d.citations === "number" && (
              <span class="rounded-full bg-amber-100 px-2 py-0.5 font-medium text-amber-800">
                Cited by {d.citations}
              </span>
            )}
            {menteeLed && (
              <span class="rounded-full bg-accent-100 px-2 py-0.5 font-medium text-accent-700">
                Mentee-led
              </span>
            )}
            {piFirstOrSenior && (
              <span class="rounded-full bg-primary-100 px-2 py-0.5 font-medium text-primary-700">
                PI first/senior
              </span>
            )}
            {collaboration && (
              <span class="rounded-full bg-slate-200 px-2 py-0.5 font-medium text-slate-600">
                Collaboration
              </span>
            )}
            {d.openAccess && (
              <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-medium text-emerald-700">
                Open access
              </span>
            )}
            {links.map((resource) => (
              <a
                href={resource.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:underline"
              >
                {resource.label}
              </a>
            ))}
            {bibtex && (
              <a
                href={`data:application/x-bibtex;charset=utf-8,${encodeURIComponent(bibtex)}`}
                download={`publication-${p.id.replace(/[^a-z0-9_-]/gi, "")}.bib`}
                class="text-primary-700 hover:underline"
              >
                BibTeX
              </a>
            )}
          </div>
          {(d.abstract || d.keywords?.length || d.authors.some((author) => author.contributions?.length || author.corresponding) || bibtex) && (
            <details class="mt-3 text-sm text-slate-600" data-bibtex-panel>
              <summary class="w-fit cursor-pointer text-primary-700 hover:underline">Details & citation</summary>
              <div class="mt-3 grid min-w-0 gap-5 border-t border-slate-100 pt-4 md:grid-cols-[12rem_minmax(0,1fr)]" data-publication-details>
                <div class="self-start overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                  {d.image ? <Image src={d.image} alt={d.imageAlt ?? ""} widths={[300, 600]} sizes="(min-width: 768px) 192px, 90vw" class="aspect-[4/3] w-full object-contain" /> : <div class="flex aspect-[4/3] flex-col items-center justify-center gap-3 p-4 text-primary-300" aria-hidden="true"><svg class="h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 12h8m-8 4h6" /></svg><span class="text-xs tracking-wide text-slate-400">Research overview</span></div>}
                </div>
                <div class="min-w-0 space-y-3">
                {d.abstract && <div><h4 class="mb-2 font-sans text-xs font-semibold tracking-wide text-slate-500 uppercase">Abstract</h4><p class="leading-relaxed">{d.abstract}</p></div>}
                {d.keywords?.length && <p><span class="font-medium">Keywords:</span> {d.keywords.join(" · ")}</p>}
                {d.authors.filter((author) => author.contributions?.length || author.corresponding || author.coFirst || author.coSenior).map((author) => (
                  <p><span class="font-medium">{author.name}:</span> {[
                    ...(author.contributions ?? []), ...(author.coFirst ? ["Co-first author"] : []),
                    ...(author.coSenior ? ["Co-senior author"] : []), ...(author.corresponding ? ["Corresponding author"] : []),
                  ].join("; ")}{author.corresponding && author.email && <> · <a href={`mailto:${author.email}`} class="text-primary-700 hover:underline">{author.email}</a></>}</p>
                ))}
                {bibtex && <div>
                  <button type="button" data-copy-bibtex class="mb-2 text-xs font-medium text-primary-700 hover:underline" aria-live="polite">Copy BibTeX</button>
                  <pre class="max-w-full overflow-x-auto rounded-md bg-slate-50 p-3 text-xs"><code data-bibtex>{bibtex}</code></pre>
                </div>}
                </div>
              </div>
            </details>
          )}
        </li>
      );
    })
  }
</ol>

{
  (anyMarks || anyCorresponding) && (
    <p class="mt-4 text-xs text-slate-600">
      {anyMarks && <><sup class="font-semibold text-slate-600">*</sup> co-first / co-senior author</>}
      {anyMarks && anyCorresponding && " · "}
      {anyCorresponding && <>† corresponding author</>}
    </p>
  )
}

<script>
  // Expand/collapse clamped author lists.
  document.querySelectorAll<HTMLButtonElement>("[data-authors-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const authors = btn.parentElement?.querySelector(".authors");
      if (!authors) return;
      const clamped = authors.classList.toggle("clamped");
      btn.textContent = clamped ? (btn.dataset.more ?? "more") : "show fewer";
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-copy-bibtex]").forEach((button) => {
    button.addEventListener("click", async () => {
      const citation = button.closest("[data-bibtex-panel]")?.querySelector("[data-bibtex]")?.textContent;
      if (!citation) return;
      try {
        await navigator.clipboard.writeText(citation);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy the citation below";
      }
    });
  });
</script>
