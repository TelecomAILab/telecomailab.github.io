---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import { getPublications, getAreaCounts, AREA_LABELS, FILTER_GROUPS } from "../lib/content";
import { PUBLICATION_TYPES, PUBLICATION_TYPE_LABELS } from "../lib/publication-schema";
import { publicationType } from "../lib/publication-format";

const pubs = await getPublications();
const areaCounts = await getAreaCounts();
const areaChips = FILTER_GROUPS.flatMap((g) => g.slugs);
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const typeCounts = Object.fromEntries(PUBLICATION_TYPES.map((type) => [type, pubs.filter((p) => publicationType(p.data) === type).length]));

const chip =
  "rounded-full border border-slate-300 px-3 py-1 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 data-[active]:border-primary-600 data-[active]:bg-primary-600 data-[active]:text-white";

const filters = [
  { key: "all", label: "All" },
  { key: "mentee", label: "Mentee-led" },
  { key: "pi", label: "PI first/senior" },
  { key: "collaboration", label: "Collaboration" },
  { key: "openaccess", label: "Open access" },
  { key: "featured", label: "Featured" },
];
---

<BaseLayout
  title="Publications"
  description="Academic publications, preprints, and research outputs. Search and filter by type, year, topic, and authorship."
>
  <PageHeader
    eyebrow="Research output"
    title="Publications"
    lead="Explore publications and academic outputs by type, year, research topic, and authorship. Search titles, authors, venues, and keywords."
  />
  <div class="container-page py-12">
    <div class="mb-8 space-y-3">
      <button
        type="button"
        id="filters-toggle"
        class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 md:hidden"
        aria-controls="pub-filters"
        aria-expanded="false"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4" />
        </svg>
        Filters
      </button>

      <div id="pub-filters" class="hidden space-y-3 md:block">
        <div class="flex flex-wrap items-center gap-2">
          {
            filters.map((f) => (
              <button class={chip} data-filter={f.key} data-active={f.key === "all" ? "" : undefined} aria-pressed={f.key === "all"}>
                {f.label} <span data-count />
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Research topic</span>
        <button class={chip} data-area="all" data-active aria-pressed="true">All topics</button>
        {
          areaChips.map((slug) => (
            <button class={chip} data-area={slug} aria-pressed="false">
              {AREA_LABELS[slug]}{" "}
              <span class="opacity-70">({areaCounts[slug] ?? 0})</span>
            </button>
          ))
        }
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Publication type</span>
          <button class={chip} data-type-filter="all" data-active aria-pressed="true">All types</button>
          {PUBLICATION_TYPES.map((type) => <button class={chip} data-type-filter={type} aria-pressed="false">{PUBLICATION_TYPE_LABELS[type]} <span class="opacity-70">({typeCounts[type]})</span></button>)}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <label class="sr-only" for="pub-search">Search publications</label>
        <input
          type="search"
          id="pub-search"
          placeholder="Search title, author, venue, or keyword…"
          class="min-w-0 basis-64 flex-1 rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-primary-500 focus:outline-none"
        />
        <label class="flex items-center gap-2 text-sm text-slate-600">Year
          <select id="pub-year" class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm">
            <option value="all">All years</option>
            {years.map((year) => <option value={year}>{year}</option>)}
          </select>
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-600">Sort
          <select id="pub-sort" class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm">
            <option value="date">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="citations">Most cited</option>
          </select>
        </label>
        <button type="button" id="pub-reset" class="text-sm text-primary-700 hover:underline">Reset</button>
        <span id="pub-count" class="text-sm text-slate-600" role="status" aria-live="polite">{pubs.length} publications</span>
      </div>
      <p id="pub-legacy-filter" class="hidden text-sm text-slate-600">Showing letter / commentary papers. Choose a topic or reset to see other outputs.</p>
    </div>

    <PubList pubs={pubs} anchorIds />

    <p id="pub-empty" class:list={[pubs.length > 0 && "hidden", "py-10 text-center text-slate-600"]}>
      {pubs.length ? "No publications match your filters." : "Publications will appear here once verified records are added."}
    </p>
  </div>

  <script>
    import "../scripts/publications";
  </script>
</BaseLayout>
