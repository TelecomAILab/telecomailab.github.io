---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
const areas = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Research" description="Research questions, approaches, and applications in intelligent communication systems.">
  <PageHeader eyebrow="Questions that connect us" title="Research" lead="Intelligent communications bring together learning, networking, and computing. Explore the questions, methods, and applications behind each direction." />
  <div class="container-page pb-16">
    <nav aria-label="Research directions" class="mb-12 flex flex-wrap gap-2 border-b border-slate-200 pb-7">{areas.map((area) => <a href={`#${area.id}`} class="rounded-full border border-slate-200 px-3 py-1.5 text-sm text-primary-700 hover:border-primary-300 hover:bg-primary-50">{area.data.title}</a>)}</nav>
    <div class="space-y-14 sm:space-y-20">{areas.map(({ id, data: area }) => <section id={id} data-research-area data-search-entry data-search-title={area.title} data-search-category="Research" class:list={["grid scroll-mt-24 items-start gap-7 lg:gap-12", area.image && "lg:grid-cols-[.9fr_1.1fr]"]}>
      {area.image && <div class="overflow-hidden rounded-2xl border border-primary-100 bg-primary-50"><Image src={area.image} alt={area.imageAlt ?? ""} widths={[500, 900]} sizes="(min-width: 1024px) 45vw, 95vw" class="aspect-[4/3] w-full object-contain" /></div>}
      <div class="min-w-0 lg:py-2">{area.isMock && <p class="mb-3 text-xs font-medium tracking-wide text-accent-700 uppercase">Example direction</p>}<h2 class="font-serif text-3xl leading-tight sm:text-4xl">{area.title}</h2><p class="mt-5 leading-relaxed text-slate-600">{area.description}</p>{area.motivation && <p class="mt-4 text-sm leading-relaxed text-slate-600"><span class="font-semibold text-slate-800">Motivation · </span>{area.motivation}</p>}{area.challenges && area.challenges.length > 0 && <p class="mt-4 text-sm leading-relaxed text-slate-600"><span class="font-semibold text-slate-800">Research challenges · </span>{area.challenges.join("; ")}</p>}<h3 class="mt-5 font-sans text-sm font-semibold text-slate-800">Approach</h3><p class="mt-2 text-sm leading-relaxed text-slate-600">{area.approach}</p><p class="mt-4 text-sm leading-relaxed text-slate-600"><span class="font-semibold text-slate-800">Potential applications · </span>{area.applications}</p>{area.links.length > 0 && <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-sm font-medium text-primary-700">{area.links.map((link) => <a href={link.url} class="hover:underline">{link.label} &rarr;</a>)}</div>}</div>
    </section>)}</div>
  </div>
</BaseLayout>
