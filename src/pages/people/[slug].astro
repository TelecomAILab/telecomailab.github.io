---
import { getCollection, getEntry, render } from "astro:content";
import ProfileLayout from "../../components/ProfileLayout.astro";
import PubList from "../../components/PubList.astro";
import { getPublications, publicationsForPerson } from "../../lib/content";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const biography = person.data.biography ? await getEntry(person.data.biography) : undefined;
if (person.data.biography && !biography) throw new Error(`Missing biography for ${person.id}`);
const Content = biography ? (await render(biography)).Content : undefined;
const hasBio = (biography?.body ?? "").trim().length > 0;
const interests = person.data.researchInterests;

const pubs = await getPublications();
const mine = publicationsForPerson(person, pubs);
---

<ProfileLayout person={person}>
  {
    hasBio && Content && (
      <div class="prose-content max-w-3xl space-y-4 leading-relaxed text-slate-700">
        <Content />
      </div>
    )
  }

  {
    interests.length > 0 && (
      <section class:list={[hasBio && "mt-10"]}>
        <h2 class="mb-1 font-serif text-xl text-slate-900">Research interests</h2>
        <ul class="list-disc space-y-1 pl-5 text-slate-700">
          {interests.map((interest) => <li>{interest}</li>)}
        </ul>
      </section>
    )
  }

  {
    mine.length > 0 && (
      <section class:list={[(hasBio || interests.length > 0) && "mt-10"]}>
        <h2 class="mb-1 font-serif text-xl text-slate-900">
          Selected publications
        </h2>
        <PubList pubs={mine} />
      </section>
    )
  }
</ProfileLayout>
