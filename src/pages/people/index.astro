---
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
---

<BaseLayout
  title="People"
  description="Meet the lab head, scientists, postdocs, students, collaborators, visitors, and alumni."
>
  <PageHeader
    eyebrow="The team"
    title="People"
    lead="The people behind our work: lab leadership, researchers, students, collaborators, visitors, and alumni."
  />
  <div class="container-page py-12">
    <nav aria-label="People groups" class="mb-12 flex flex-wrap gap-2">
      {groups.map((g) => <a href={`#${g.group.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`} class="rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-600 transition-colors hover:border-primary-300 hover:bg-primary-50 hover:text-primary-800">{g.group} <span class="ml-1 text-slate-400">{g.people.length}</span></a>)}
    </nav>
    {groups.map((g) => <PersonGroup title={g.group} people={g.people} />)}
  </div>
</BaseLayout>
