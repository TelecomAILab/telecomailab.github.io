---
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import {
  getPublications,
  featuredMatcher,
  featuredSorter,
} from "../lib/content";
import PubList from "../components/PubList.astro";

import { getNews } from "../lib/editorial";
import NewsList from "../components/NewsList.astro";

const labMoment = (await getCollection("gallery")).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime())[0];
const allNews = await getNews();
const news = allNews.slice(0, 6);

const people = await getCollection("people");
const pubs = await getPublications();
// Featured = mentee-led or PI first/senior (>=2019), prioritized mentee-led
// first then most recent.
const recent = pubs
  .filter(featuredMatcher(people))
  .sort(featuredSorter(people))
  .slice(0, 5);

// Homepage "Research areas" cards. Replace these with your lab's themes; each
// `href` can deep-link into the Research page's grouped sections (e.g.
// "/research#your-slug" once you set up the taxonomy in content.config.ts).
const themes = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order).slice(0, 4).map((area) => ({
  title: area.data.title, href: `/research#${area.id}`, body: area.data.summary,
}));
---

<BaseLayout>
  <!-- Hero -->
  <section data-search-page class="bg-gradient-to-b from-primary-50 to-white">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold tracking-wide text-accent-600 uppercase">
          {site.institution} · {site.university}
        </p>
        <h1
          class="mt-4 text-4xl leading-tight font-semibold text-slate-900 sm:text-5xl"
        >
          {site.name}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">{site.description}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/research"
            class="rounded-md bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-800"
            >Explore our research</a
          >
          <a
            href="/people"
            class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
            >Meet the team</a
          >
        </div>
      </div>

    </div>
  </section>

  <!-- Recent announcements -->
  {news.length > 0 && <section class="border-y border-slate-200 bg-slate-50/60" aria-labelledby="news-heading">
    <div class="container-page py-14">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div><h2 id="news-heading" class="font-serif text-2xl text-slate-900">News</h2></div>{allNews.length > news.length && <a href="/news" class="text-sm font-medium text-primary-700 hover:text-accent-600">View all news &rarr;</a>}</div>
      <NewsList entries={news} homepage />
    </div>
  </section>}

  <!-- Research themes -->
  <section class="container-page py-16">
    <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
    <h2 class="mb-8 font-serif text-2xl text-slate-900">Research areas</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        themes.map((t) => (
          <a
            href={t.href}
            class="group rounded-xl border border-slate-200 p-6 transition-colors hover:border-primary-300 hover:bg-primary-50/40"
          >
            <h3 class="font-serif text-xl text-slate-900 group-hover:text-primary-700">
              {t.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{t.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent featured publications -->
  {
    recent.length > 0 && (
      <section class="border-t border-slate-200 bg-slate-50">
        <div class="container-page py-16">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500" />
              <h2 class="font-serif text-2xl text-slate-900">Recent work</h2>
            </div>
            <a
              href="/publications"
              class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
            >
              All publications
              <span
                class="transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </div>
          <PubList pubs={recent} />
        </div>
      </section>
    )
  }

  <!-- Life in the lab -->
  <section class="border-t border-slate-200 bg-white">
    <div class="container-page py-16">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-2xl text-slate-900">Life in the lab</h2>
          <p class="mt-4 max-w-prose text-slate-600">
            Conversations, shared ideas, and time together are part of research.
            Explore the people and moments behind the work.
          </p>
          <a
            href="/about#lab-life"
            class="group mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
          >
            Explore lab life
            <span
              class="transition-transform group-hover:translate-x-0.5"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </div>
        {labMoment && <a
          href="/about#lab-life"
          class="group block overflow-hidden rounded-2xl border border-slate-200 shadow-sm"
        >
          <Image
            src={labMoment.data.image}
            alt={labMoment.data.caption}
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
          {labMoment.data.kind === "illustration" && <p class="bg-white px-4 py-2 text-xs text-slate-500">Illustration · {labMoment.data.title}</p>}
        </a>}
      </div>
    </div>
  </section>
</BaseLayout>
